---
import type { HTMLAttributes } from 'astro/types';
import { cn } from '../lib/utils.js';
import { popoverPresentation } from '../lib/popover-presentation.js';
type Props = HTMLAttributes<'h2'>;
const { class: className, ...attributes } = Astro.props;
---
<h2 data-slot="popover-title" {...attributes} class={cn(popoverPresentation.Title, className)}><slot /></h2>
