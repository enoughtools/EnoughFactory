---
import type { HTMLAttributes } from 'astro/types';
import { cn } from '../lib/utils.js';
import { typographyVariants } from '../lib/variants.js';
type Props = HTMLAttributes<'h2'>;
const {class: className, ...attributes} = Astro.props;
---
<h2 {...attributes} data-slot="typography-h2" class={cn(typographyVariants({variant:"h2"}),className)}><slot /></h2>
