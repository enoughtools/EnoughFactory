---
import type { HTMLAttributes } from 'astro/types';
import { cn } from '../lib/utils.js';
import { presentation } from '../lib/presentation.js';
type Props = HTMLAttributes<'thead'>;
const { class: className, ...attributes } = Astro.props;
---
<thead data-slot="table-header" {...attributes} class={cn(presentation.TableHeader, className)}><slot /></thead>
