---
import type { HTMLAttributes } from 'astro/types';
import { cn } from '../lib/utils.js';
import { presentation } from '../lib/presentation.js';
type Props = HTMLAttributes<'kbd'>;
const { class: className, ...attributes } = Astro.props;
---
<kbd data-slot="kbd" {...attributes} class={cn(presentation.Kbd, className)}><slot /></kbd>
