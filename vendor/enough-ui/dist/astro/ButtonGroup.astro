---
import type { HTMLAttributes } from 'astro/types';
import { cn } from '../lib/utils.js';
import { buttonGroupVariants } from '../lib/variants.js';
import type { VariantProps } from 'class-variance-authority';
type Props = Omit<HTMLAttributes<'div'>, keyof VariantProps<typeof buttonGroupVariants>> & VariantProps<typeof buttonGroupVariants>;
const { class: className, orientation, ...attributes } = Astro.props;
---
<div role="group" data-slot="button-group" data-orientation={orientation ?? "horizontal"} {...attributes} class={cn(buttonGroupVariants({ orientation }), className)}><slot /></div>
