---
import type { HTMLAttributes } from 'astro/types';
import { cn } from '../lib/utils.js';
import { apiPresentation } from '../lib/api-presentation.js';
type Props = HTMLAttributes<'span'>;
const { class: className, ...attributes } = Astro.props;
---
<span data-slot="marker-icon" aria-hidden="true" {...attributes} class={cn(apiPresentation.MarkerIcon, className)}><slot /></span>
