---
import type { HTMLAttributes } from 'astro/types';
import { cn } from '../lib/utils.js';
import { presentation } from '../lib/presentation.js';
type Props = HTMLAttributes<'table'>;
const { class: className, ...attributes } = Astro.props;
---
<div data-slot="table-container" class="relative w-full overflow-x-auto rounded-none border border-[var(--color-ink)] bg-[var(--color-surface)] shadow-[var(--shadow-card)]"><table data-slot="table" {...attributes} class={cn(presentation.Table, className)}><slot /></table></div>
