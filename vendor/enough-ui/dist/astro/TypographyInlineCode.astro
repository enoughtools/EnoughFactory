---
import type { HTMLAttributes } from 'astro/types';
import { cn } from '../lib/utils.js';
import { presentation } from '../lib/presentation.js';
type Props = HTMLAttributes<'code'>;
const { class: className, ...attributes } = Astro.props;
---
<code data-slot="typography-inline-code" {...attributes} class={cn(presentation.TypographyInlineCode, className)}><slot /></code>
