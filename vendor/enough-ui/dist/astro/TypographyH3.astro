---
import type { HTMLAttributes } from 'astro/types';
import { cn } from '../lib/utils.js';
import { typographyVariants } from '../lib/variants.js';
type Props = HTMLAttributes<'h3'>;
const {class: className, ...attributes} = Astro.props;
---
<h3 {...attributes} data-slot="typography-h3" class={cn(typographyVariants({variant:"h3"}),className)}><slot /></h3>
