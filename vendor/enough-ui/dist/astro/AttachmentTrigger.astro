---
import type { HTMLAttributes } from 'astro/types';
import { conversation } from '../lib/conversation.js';
import { cn } from '../lib/utils.js';
type Props = HTMLAttributes<'button'> & {
  href?: string;
  target?: HTMLAttributes<'a'>['target'];
  rel?: string;
  download?: HTMLAttributes<'a'>['download'];
};
const { href, target, rel, download, class: className, disabled, type = 'button', 'data-slot': dataSlot = 'attachment-trigger', ...attributes } = Astro.props;
const isDisabled = disabled === true || disabled === '';
const classes = cn(conversation.AttachmentTrigger, isDisabled && 'pointer-events-none opacity-50', className);
---
{href !== undefined ? (
  <a data-slot={dataSlot} {...attributes} role={isDisabled ? attributes.role ?? 'link' : attributes.role} href={isDisabled ? undefined : href} target={target} rel={rel} download={download}
    aria-disabled={isDisabled || undefined} tabindex={isDisabled ? -1 : attributes.tabindex} class={classes}><slot /></a>
) : (
  <button data-slot={dataSlot} {...attributes} type={type} disabled={isDisabled} class={classes}><slot /></button>
)}
