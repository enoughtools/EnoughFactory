---
import type { HTMLAttributes } from 'astro/types';
import { cn } from '../lib/utils.js';
import { typographyVariants } from '../lib/variants.js';
type Props = HTMLAttributes<'small'>;
const {class: className, ...attributes} = Astro.props;
---
<small {...attributes} data-slot="typography-small" class={cn(typographyVariants({variant:"small"}),className)}><slot /></small>
