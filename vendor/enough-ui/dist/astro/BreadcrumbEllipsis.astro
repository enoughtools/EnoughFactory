---
import type { HTMLAttributes } from 'astro/types';
import { cn } from '../lib/utils.js';
import { presentation } from '../lib/presentation.js';
type Props = HTMLAttributes<'span'>;
const { class: className, ...attributes } = Astro.props;
---
<span role="presentation" aria-hidden="true" {...attributes} class={cn(presentation.BreadcrumbEllipsis, className)}>…</span>
