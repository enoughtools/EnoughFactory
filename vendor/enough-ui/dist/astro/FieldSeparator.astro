---
import type { HTMLAttributes } from 'astro/types';
import { cn } from '../lib/utils.js';
import { presentation } from '../lib/presentation.js';
type Props = HTMLAttributes<'div'>;
const {class: className, ...attributes} = Astro.props;
---
<div {...attributes} role="separator" data-slot="field-separator" class={cn(presentation.FieldSeparator,className)}>{Astro.slots.has("default") && <span class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 bg-[var(--color-surface)] px-2 font-sans text-[10px] uppercase tracking-[0.12em] text-[var(--color-text-3)]"><slot /></span>}</div>
