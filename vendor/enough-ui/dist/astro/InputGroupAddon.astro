---
import type { HTMLAttributes } from 'astro/types';
import { cn } from '../lib/utils.js';
import { inputGroupAddonVariants } from '../lib/variants.js';
import type { VariantProps } from 'class-variance-authority';
type Props = Omit<HTMLAttributes<'div'>, keyof VariantProps<typeof inputGroupAddonVariants>> & VariantProps<typeof inputGroupAddonVariants>;
const { class: className, align, ...attributes } = Astro.props;
---
<div data-slot="input-group-addon" data-align={align ?? "inline-start"} {...attributes} class={cn(inputGroupAddonVariants({ align }), className)}><slot /></div>
