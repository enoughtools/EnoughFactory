---
import type { HTMLAttributes } from 'astro/types';
import { cn } from '../lib/utils.js';
import { typographyVariants } from '../lib/variants.js';
type Props = HTMLAttributes<'p'>;
const {class: className, ...attributes} = Astro.props;
---
<p {...attributes} data-slot="typography-lead" class={cn(typographyVariants({variant:"lead"}),className)}><slot /></p>
