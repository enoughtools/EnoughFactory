---
import type { HTMLAttributes } from 'astro/types';
import { cn } from '../lib/utils.js';

type Props = HTMLAttributes<'h5'>;
const {class: className, ...attributes} = Astro.props;
---
<h5 data-slot="alert-title" {...attributes} class={cn("mb-1 font-medium leading-none tracking-tight", className)}><slot /></h5>
