---
import type { HTMLAttributes } from 'astro/types';
import { cn } from '../lib/utils.js';
import { presentation } from '../lib/presentation.js';
type Props = HTMLAttributes<'div'>;
const { class: className, ...attributes } = Astro.props;
---
<div data-slot="item-group" role={attributes.role ?? 'group'} {...attributes} class={cn(presentation.ItemGroup, className)}><slot /></div>
