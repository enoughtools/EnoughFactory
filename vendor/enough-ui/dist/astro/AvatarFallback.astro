---
import type { HTMLAttributes } from 'astro/types';
import { cn } from '../lib/utils.js';
import { avatarFallbackClass } from '../lib/minor-presentation.js';

type Props = HTMLAttributes<'span'>;
const { class: className, ...attributes } = Astro.props;
---
<span {...attributes} data-slot="avatar-fallback" class={cn(avatarFallbackClass, className)}><slot /></span>
