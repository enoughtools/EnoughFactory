---
import type { HTMLAttributes } from 'astro/types';
import { cn } from '../lib/utils.js';
import { presentation } from '../lib/presentation.js';
type Props = HTMLAttributes<'li'>;
const { class: className, ...attributes } = Astro.props;
---
<li role="presentation" aria-hidden="true" {...attributes} class={cn(presentation.BreadcrumbSeparator, className)}><slot>/</slot></li>
