---
import type { HTMLAttributes } from 'astro/types';
import { cn } from '../lib/utils.js';
import { presentation } from '../lib/presentation.js';
type Props = HTMLAttributes<'span'>;
const { class: className, ...attributes } = Astro.props;
---
<span role="link" aria-disabled="true" aria-current="page" {...attributes} class={cn(presentation.BreadcrumbPage, className)}><slot /></span>
