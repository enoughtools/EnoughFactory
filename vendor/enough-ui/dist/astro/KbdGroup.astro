---
import type { HTMLAttributes } from 'astro/types';
import { cn } from '../lib/utils.js';
import { presentation } from '../lib/presentation.js';
type Props = HTMLAttributes<'span'>;
const { class: className, ...attributes } = Astro.props;
---
<span role={attributes.role ?? 'group'} data-slot="kbd-group" {...attributes} class={cn(presentation.KbdGroup, className)}><slot /></span>
