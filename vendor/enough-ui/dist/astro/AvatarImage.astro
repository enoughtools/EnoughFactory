---
import type { HTMLAttributes } from 'astro/types';
import { cn } from '../lib/utils.js';
import { avatarImageClass } from '../lib/minor-presentation.js';

type Props = HTMLAttributes<'img'>;
const { class: className, ...attributes } = Astro.props;
---
<img {...attributes} data-slot="avatar-image" class={cn(avatarImageClass, className)} />
