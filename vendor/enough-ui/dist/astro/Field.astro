---
import type { HTMLAttributes } from 'astro/types';
import { cn } from '../lib/utils.js';
import { fieldVariants } from '../lib/variants.js';
import type { VariantProps } from 'class-variance-authority';
type Props = Omit<HTMLAttributes<'div'>, keyof VariantProps<typeof fieldVariants>> & VariantProps<typeof fieldVariants>;
const { class: className, orientation, ...attributes } = Astro.props;
---
<div role="group" data-slot="field" data-orientation={orientation ?? "vertical"} {...attributes} class={cn(fieldVariants({ orientation }), className)}><slot /></div>
