---
import type { HTMLAttributes } from 'astro/types';
import { conversation } from '../lib/conversation.js';
import { cn } from '../lib/utils.js';
type Props = HTMLAttributes<'div'>;
const { class: className, ...attributes } = Astro.props;
---
<div {...attributes} data-slot="attachment-content" class={cn(conversation.AttachmentContent, className)}><slot /></div>
