---
import type { HTMLAttributes } from 'astro/types';
import { cn } from '../lib/utils.js';
import { typographyVariants } from '../lib/variants.js';
type Props = HTMLAttributes<'div'>;
const {class: className, ...attributes} = Astro.props;
---
<div {...attributes} data-slot="typography-large" class={cn(typographyVariants({variant:"large"}),className)}><slot /></div>
