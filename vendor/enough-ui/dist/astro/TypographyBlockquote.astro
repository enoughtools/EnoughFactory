---
import type { HTMLAttributes } from 'astro/types';
import { cn } from '../lib/utils.js';
import { presentation } from '../lib/presentation.js';
type Props = HTMLAttributes<'blockquote'>;
const { class: className, ...attributes } = Astro.props;
---
<blockquote data-slot="typography-blockquote" {...attributes} class={cn(presentation.TypographyBlockquote, className)}><slot /></blockquote>
