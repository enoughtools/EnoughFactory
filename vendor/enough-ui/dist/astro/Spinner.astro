---
import type { HTMLAttributes } from 'astro/types';
import { cn } from '../lib/utils.js';
import { spinnerVariants } from '../lib/variants.js';
import type { VariantProps } from 'class-variance-authority';
type Props = HTMLAttributes<'span'> & VariantProps<typeof spinnerVariants> & {label?:string};
const {class: className, size, label = 'Loading', ...attributes} = Astro.props;
---
<span {...attributes} role="status" aria-label={label} data-slot="spinner" class={cn(spinnerVariants({size}),className)}><svg aria-hidden="true" class="animate-spin motion-reduce:animate-none h-full w-full" viewBox="0 0 24 24" fill="none"><rect x="3" y="3" width="18" height="18" stroke="var(--color-ink)" stroke-width="4"/><rect x="3" y="3" width="9" height="9" fill="var(--color-accent)"/></svg></span>
