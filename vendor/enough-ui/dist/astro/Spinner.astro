---
import type { HTMLAttributes } from 'astro/types';
import { cn } from '../lib/utils.js';
import { spinnerVariants } from '../lib/variants.js';
import type { VariantProps } from 'class-variance-authority';
type Props = HTMLAttributes<'span'> & VariantProps<typeof spinnerVariants> & {label?:string};
const {class: className, size, label = 'Loading', 'aria-hidden': ariaHidden, ...attributes} = Astro.props;
const hidden = ariaHidden === true || ariaHidden === 'true';
---
<span {...attributes} role={hidden ? undefined : attributes.role ?? 'status'} aria-hidden={ariaHidden} aria-label={hidden ? undefined : attributes['aria-label'] ?? label} data-slot="spinner" class={cn(spinnerVariants({size}),className)}>
  <svg data-slot="spinner-icon" aria-hidden="true" focusable="false" style="width:100%;height:100%" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
    <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2.5" opacity="0.2" />
    <path d="M12 3a9 9 0 0 1 9 9" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" />
  </svg>
</span>
