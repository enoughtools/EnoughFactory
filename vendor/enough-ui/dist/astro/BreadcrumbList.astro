---
import type { HTMLAttributes } from 'astro/types';
import { cn } from '../lib/utils.js';
import { presentation } from '../lib/presentation.js';
type Props = HTMLAttributes<'ol'>;
const { class: className, ...attributes } = Astro.props;
---
<ol  {...attributes} class={cn(presentation.BreadcrumbList, className)}><slot /></ol>
