---
import type { HTMLAttributes } from 'astro/types';
import { cn } from '../lib/utils.js';
import { presentation } from '../lib/presentation.js';
type Props = HTMLAttributes<'span'>;
const { class: className, ...attributes } = Astro.props;
---
<span data-slot="pagination-ellipsis" {...attributes} class={cn(presentation.PaginationEllipsis, className)}><span aria-hidden="true">…</span><span class="sr-only">More pages</span></span>
