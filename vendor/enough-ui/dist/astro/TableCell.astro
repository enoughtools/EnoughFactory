---
import type { HTMLAttributes } from 'astro/types';
import { cn } from '../lib/utils.js';
import { presentation } from '../lib/presentation.js';
type Props = HTMLAttributes<'td'>;
const { class: className, ...attributes } = Astro.props;
---
<td data-slot="table-cell" {...attributes} class={cn(presentation.TableCell, className)}><slot /></td>
