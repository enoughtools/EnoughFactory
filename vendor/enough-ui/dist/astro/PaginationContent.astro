---
import type { HTMLAttributes } from 'astro/types';
import { cn } from '../lib/utils.js';
import { presentation } from '../lib/presentation.js';
type Props = HTMLAttributes<'ul'>;
const { class: className, ...attributes } = Astro.props;
---
<ul data-slot="pagination-content" {...attributes} class={cn(presentation.PaginationContent, className)}><slot /></ul>
