---
import type { HTMLAttributes } from 'astro/types';
import { cn } from '../lib/utils.js';
import { presentation } from '../lib/presentation.js';
type Props = HTMLAttributes<'label'>;
const { class: className, ...attributes } = Astro.props;
---
<label data-slot="field-label" {...attributes} class={cn(presentation.FieldLabel, className)}><slot /></label>
