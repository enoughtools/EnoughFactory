---
import type { HTMLAttributes } from 'astro/types';
import { cn } from '../lib/utils.js';
import { presentation } from '../lib/presentation.js';
type Props = HTMLAttributes<'th'>;
const { class: className, ...attributes } = Astro.props;
---
<th data-slot="table-head" {...attributes} class={cn(presentation.TableHead, className)}><slot /></th>
