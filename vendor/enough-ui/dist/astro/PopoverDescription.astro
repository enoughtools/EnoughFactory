---
import type { HTMLAttributes } from 'astro/types';
import { cn } from '../lib/utils.js';
import { popoverPresentation } from '../lib/popover-presentation.js';
type Props = HTMLAttributes<'p'>;
const { class: className, ...attributes } = Astro.props;
---
<p data-slot="popover-description" {...attributes} class={cn(popoverPresentation.Description, className)}><slot /></p>
