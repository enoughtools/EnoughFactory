---
import type { HTMLAttributes } from 'astro/types';
import { cn } from '../lib/utils.js';
import { presentation } from '../lib/presentation.js';
type Props = HTMLAttributes<'tfoot'>;
const { class: className, ...attributes } = Astro.props;
---
<tfoot data-slot="table-footer" {...attributes} class={cn(presentation.TableFooter, className)}><slot /></tfoot>
