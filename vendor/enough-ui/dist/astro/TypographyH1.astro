---
import type { HTMLAttributes } from 'astro/types';
import { cn } from '../lib/utils.js';
import { typographyVariants } from '../lib/variants.js';
type Props = HTMLAttributes<'h1'>;
const {class: className, ...attributes} = Astro.props;
---
<h1 {...attributes} data-slot="typography-h1" class={cn(typographyVariants({variant:"h1"}),className)}><slot /></h1>
