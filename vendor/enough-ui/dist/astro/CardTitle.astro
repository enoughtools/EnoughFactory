---
import type { HTMLAttributes } from 'astro/types';
import { cn } from '../lib/utils.js';
import { presentation } from '../lib/presentation.js';
type Props = HTMLAttributes<'h3'>;
const { class: className, ...attributes } = Astro.props;
---
<h3 data-slot="card-title" {...attributes} class={cn(presentation.CardTitle, className)}><slot /></h3>
