---
import type { HTMLAttributes } from 'astro/types';
import { cn } from '../lib/utils.js';
import { presentation } from '../lib/presentation.js';
type Props = HTMLAttributes<'p'>;
const { class: className, ...attributes } = Astro.props;
---
<p data-slot="field-description" {...attributes} class={cn(presentation.FieldDescription, className)}><slot /></p>
