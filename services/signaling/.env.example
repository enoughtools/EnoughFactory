# Copy to .env. Keep .env out of source control.
PORT=8788
ENOUGH_SIGNALING_HOST=0.0.0.0
ENOUGH_SIGNALING_ALLOW_RELAY=true
# Optional browser Origin allowlist; native device services usually send no Origin.
ENOUGH_SIGNALING_ALLOWED_ORIGINS=
# Optional comma-separated identity IDs allowed to authenticate. Required with TURN.
ENOUGH_SIGNALING_DEVICE_IDS=
STUN_URLS=stun:stun.cloudflare.com:3478
# Leave TURN empty unless a server is available; clients receive temporary credentials.
TURN_URLS=
TURN_SECRET=
TURN_TTL_SECONDS=3600
# Optional managed TURN instead of coturn. Requires DEVICE_IDS admission above.
# Both values stay on the server; clients receive only expiring generated credentials.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=

# Compose TLS profile: public DNS name with ports 80/443 reachable.
SIGNALING_DOMAIN=signal.example.com
# Compose binds the raw HTTP/WS service to loopback; Caddy uses the internal network.
SIGNALING_BIND_ADDRESS=127.0.0.1

# Optional turn profile on a Linux server. Generate TURN_SECRET before enabling.
TURN_REALM=turn.example.com
TURN_EXTERNAL_IP=
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200
