{
  "name": "@enoughfactory/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "EnoughFactory — your devices, one software factory",
  "author": "Enough Tools",
  "license": "MIT",
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
